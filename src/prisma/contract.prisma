// use prisma-8

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  profile Profile?
  jobAnalysis JobAnalysis[]
  recommendations Recommendation[]
}

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique

  skills           String[]
  university       String
  certifications   String[]
  projects         Json
  degree           String
  workEnvironment  String
  workLocation     String
  roles            String[]
  languages        String[]
  experience       Json?
  jobLevel         String
  availability     String

  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobAnalysis{
  id    String  @id  @default(uuid())

  jobText    String
  result     Json
  
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   TimestamptzString  @default(now())
  updatedAt   temporal.updatedAtString()
}

model Job{
  id  String  @id  @default(uuid())
  externalJobId  String   @unique
  
  title String
  description  String
  location  String
  applyUrl String
  employmentType String
  minSalary Int?
  maxSalary Int?
  requiredSkills String[]

  company String
  companyLogo String?
  companyWebsite String?
  postedAt DateTime()?

  aiIndexed Boolean @default(false)

  createdAt   TimestamptzString  @default(now())
  updatedAt   temporal.updatedAtString()
  
  recommendations Recommendation[]
}

model Recommendation{
  id  String @id  @default(uuid())
  userId String
  jobId String
  score Float
  status  RecommendationStatus @default(new)

  createdAt   TimestamptzString  @default(now())
  updatedAt   temporal.updatedAtString()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, status, score])
}

enum RecommendationStatus {
  new
  applied
  dismissed
}